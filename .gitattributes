# Normalise line endings to LF in the repository and in the working tree on
# every platform.
#
# Without this, Git's autocrlf on Windows checks files out with CRLF while
# Prettier is configured with `endOfLine: lf`, so `pnpm format:check` fails on
# a fresh Windows clone and CI disagrees with the developer's machine.
* text=auto eol=lf

# Binary files must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated: keep it out of diffs and reviews.
pnpm-lock.yaml -diff linguist-generated
