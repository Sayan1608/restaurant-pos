# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every variable here is validated at API boot by
# apps/api/src/config/env.ts -- a missing or malformed value fails fast.
# ---------------------------------------------------------------------------

# runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# postgres (matches docker-compose.yml)
# Host ports are deliberately off the defaults -- 5432/6379 are usually already
# taken by another local stack. Change the pair together if you move them.
POSTGRES_PORT=5434
DATABASE_URL=postgresql://pos:pos@localhost:5434/pos?schema=public

# redis (BullMQ, from Step 9 onward)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# auth
# Generate your own for any shared or deployed environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PAIRING_CODE_TTL_MINUTES=10

# tenancy defaults used by the seed script
SEED_TENANT_NAME=Spice Garden
SEED_OUTLET_NAME=Spice Garden - MG Road
SEED_OUTLET_GSTIN=29ABCDE1234F1Z5
SEED_OUTLET_CURRENCY=INR
SEED_OUTLET_TIMEZONE=Asia/Kolkata
